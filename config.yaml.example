# Quant Flow 配置示例
#
# 所有键都有内置默认值，按需覆盖即可——最小可运行配置只需 llm 段与 trading.symbols。
# 敏感信息（私钥、API Key）一律放 .env，绝不写在本文件。

llm:
  base_url: https://api.deepseek.com/v1   # 任意 OpenAI 兼容端点
  model: deepseek-chat
  temperature: 0.2                        # 交易决策建议低温度

trading:
  symbols: [BTC]            # 交易对（简单符号，非 BTC/USDT 格式）
  perp_enabled: true        # 永续策略开关
  grid_enabled: false       # 网格策略开关（使用 symbols[0]，可与永续并行）
  max_trade_amount: 100     # 单笔投入上限（USD）
  max_leverage: 5
  max_positions: 3          # 永续最大同时持仓数
  take_profit_ratio: 0.05   # 止盈：开仓价 +5%
  stop_loss_ratio: 0.02     # 止损：开仓价 -2%
  timeframe: 1h             # 决策 K 线周期（永续按 K 线收盘节拍触发）

# 网格策略（安全机制全部默认启用，以下为常用旋钮）
grid:
  interval_minutes: 5               # 决策周期（分钟）
  width_min_pct: 0.02               # 网格宽度下限 2%
  width_max_pct: 0.15               # 网格宽度上限 15%
  max_position_notional_usd: 0      # 库存硬上限（USD 名义额，0=关闭）
  halt_below_usd: 0                 # 净值停机线（0=关闭）
  # Triple Barrier 全局兜底（可省略，默认 -5% 止损 / +10% 止盈 / 4h 时限）
  # barrier:
  #   stop_loss_pct: 0.05
  #   take_profit_pct: 0.10
  #   time_limit_seconds: 14400

# 账户保护链（省略本段 = 使用下列默认；protections: [] = 全部关闭）
# protections:
#   - name: max_drawdown
#     max_drawdown_pct: 0.10        # 最大回撤 10% → 全部平仓
#     pause_hours: 4
#   - name: daily_loss
#     max_daily_loss_pct: 0.05      # 单日亏损 5% → 暂停新开仓
#     pause_hours: 4
#   - name: consecutive_loss
#     max_consecutive_losses: 5     # 连续亏损 5 次 → 锁定该交易对
#     per_symbol: true
#     pause_hours: 4
#   - name: position_timeout
#     max_position_hours: 48        # 持仓超时 → 自动平仓
