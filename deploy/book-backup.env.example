# 盘口数据备份配置（复制到 /etc/quantflow/book-backup.env，权限 0600，属主 ubuntu）
# rsync 目标：user@host:/path（走 ssh，密钥放 ~ubuntu/.ssh 且目标主机已在 known_hosts）或本机挂载路径
BOOK_BACKUP_DEST=
BOOK_DIR=/home/ubuntu/quantflow/data/book
BOOK_BACKUP_SSH_OPTS=-o BatchMode=yes -o StrictHostKeyChecking=yes
BOOK_LOCAL_KEEP_DAYS=45
BOOK_REMOTE_KEEP_DAYS=90
