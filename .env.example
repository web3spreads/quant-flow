# 环境变量清单：在启动 dsh 的 shell 中导出（或由部署工具注入）。
# 插件直接读取 process.env，不加载本文件——此文件仅作核对清单/模板。

# ── LLM（仅 llm.provider=openai 时使用；默认 provider=rule 不发任何外部请求，dsh 走宿主无需密钥）──
# 任意 OpenAI 兼容端点的 API 密钥（端点与模型在插件配置的 llm 段）
# 兼容旧变量名 OPENAI_API_KEY
LLM_API_KEY=your_api_key_here

# ── Hyperliquid ──────────────────────────────────────────────────────────
# 钱包私钥（0x 开头）。⚠️ 妥善保管，切勿泄露！
#
# 单钱包模式（推荐个人使用）：填钱包私钥，ACCOUNT_ADDRESS 留空
# API 钱包模式：填 API 钱包私钥，ACCOUNT_ADDRESS 填主钱包地址
#（需先在 https://app.hyperliquid.xyz/ 的 API Trading 中授权 API 钱包）
HYPERLIQUID_PRIVATE_KEY=0x
HYPERLIQUID_ACCOUNT_ADDRESS=

# 测试网/主网切换：true=测试网（默认），false=主网
HYPERLIQUID_TESTNET=true

# ── 主网双重闸（HYPERLIQUID_TESTNET=false 时两者缺一即拒绝启动）──────────
# ① 名义额硬上限（USD）：持仓 + 非 reduce_only 挂单 + 本批开仓单 超过即拒单
QUANTFLOW_MAINNET_MAX_NOTIONAL_USD=
# ② 配置指纹确认：填启动日志「🔏 配置指纹」/ 拒绝启动信息里的 64 位 SHA-256；
#    任何影响下单的配置（交易对/杠杆/网格/保护链/决策来源/上限/钱包）一变即需重新确认
QUANTFLOW_MAINNET_ACK=
# 多账户模式：条目的 mainnet_max_notional_env / mainnet_ack_env 指定各自的变量名

# ── 看板 ─────────────────────────────────────────────────────────────────
# 看板访问令牌：设置后所有看板 API 需携带 Bearer Token。
# 看板监听非 127.0.0.1 时必须设置。
QUANTFLOW_WEB_TOKEN=
