# ── LLM ──────────────────────────────────────────────────────────────────
# 任意 OpenAI 兼容端点的 API 密钥（端点与模型在 config.yaml 的 llm 段配置）
# 兼容旧变量名 OPENAI_API_KEY
LLM_API_KEY=your_api_key_here

# ── Hyperliquid ──────────────────────────────────────────────────────────
# 钱包私钥（0x 开头）。⚠️ 妥善保管，切勿泄露！
#
# 单钱包模式（推荐个人使用）：填钱包私钥，ACCOUNT_ADDRESS 留空
# API 钱包模式：填 API 钱包私钥，ACCOUNT_ADDRESS 填主钱包地址
#（需先在 https://app.hyperliquid.xyz/ 的 API Trading 中授权 API 钱包）
HYPERLIQUID_PRIVATE_KEY=0x
HYPERLIQUID_ACCOUNT_ADDRESS=

# 测试网/主网切换：true=测试网（默认），false=主网
HYPERLIQUID_TESTNET=true

# ── 日志 ─────────────────────────────────────────────────────────────────
# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
