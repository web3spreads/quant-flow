# ==========================================
# OpenAI 兼容 API 配置
# ==========================================
# API Base URL（如果使用 deepseek 官方，设置为 https://api.deepseek.com/v1）
# 如果使用其他兼容服务（如 DeepSeek、本地部署等），修改为对应的 base_url
OPENAI_API_BASE=https://api.deepseek.com/v1

# API Key
OPENAI_API_KEY=your_deepseek_api_key_here

# 使用的模型名称
OPENAI_MODEL=deepseek-chat

# ==========================================
# Hyperliquid 交易所配置
# ==========================================
# 支持两种钱包模式：
#
# 【模式1: 单钱包模式】（⭐ 推荐用于测试网和个人使用）
#   配置方法:
#   - HYPERLIQUID_PRIVATE_KEY = 钱包私钥
#   - HYPERLIQUID_ACCOUNT_ADDRESS = (留空)
#   - 直接使用该钱包进行交易，无需额外授权
#
#   示例:
#   HYPERLIQUID_PRIVATE_KEY=0x1234567890abcdef...
#   HYPERLIQUID_ACCOUNT_ADDRESS=
#
# 【模式2: API 钱包代理模式】（推荐用于生产环境）
#   配置方法:
#   - HYPERLIQUID_PRIVATE_KEY = API 钱包的私钥（用于签名交易）
#   - HYPERLIQUID_ACCOUNT_ADDRESS = 主钱包地址（有余额的钱包）
#   - API 钱包代理主钱包进行交易
#   - ⚠️ 需要在主钱包的网页端授权 API 钱包地址！
#
#   授权步骤:
#   1. 使用主钱包登录 https://app.hyperliquid.xyz/
#   2. 在设置中找到"API Trading"或"授权地址"
#   3. 添加并授权你的 API 钱包地址
#
#   示例:
#   HYPERLIQUID_PRIVATE_KEY=0xabcdef1234567890...  # API钱包私钥
#   HYPERLIQUID_ACCOUNT_ADDRESS=0x9876543210fedcba...  # 主钱包地址
#
# ==========================================

# 钱包私钥（0x开头的十六进制字符串）
# ⚠️ 请妥善保管，切勿泄露！
#
# 单钱包模式: 填写你的钱包私钥
# API 钱包模式: 填写 API 钱包的私钥
HYPERLIQUID_PRIVATE_KEY=0x

# 主钱包地址（可选，仅用于 API 钱包模式）
#
# ⭐ 如果你是测试网用户或个人使用，建议留空使用单钱包模式
# 单钱包模式: 留空
# API 钱包模式: 填写主钱包地址（0x开头，42个字符）
HYPERLIQUID_ACCOUNT_ADDRESS=

# 是否使用测试网
# true=测试网（Testnet），false=主网（Mainnet）
HYPERLIQUID_TESTNET=true

# ==========================================
# Exa 搜索 API 配置（可选）
# ==========================================
# Exa API Key（用于外部信息收集 Agent）
# 获取方式：访问 https://exa.ai/ 注册并获取 API Key
# 如果不配置，外部信息收集功能将不可用
EXA_API_KEY=

# ==========================================
# 日志配置
# ==========================================
# 日志级别 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
