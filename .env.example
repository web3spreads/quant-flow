# ==========================================
# OpenAI 兼容 API 配置
# ==========================================
# API Base URL（如果使用 OpenAI 官方，设置为 https://api.openai.com/v1）
# 如果使用其他兼容服务（如 DeepSeek、本地部署等），修改为对应的 base_url
OPENAI_API_BASE=https://api.openai.com/v1

# API Key
OPENAI_API_KEY=your_openai_api_key_here

# 使用的模型名称
OPENAI_MODEL=gpt-4

# ==========================================
# Bitget 交易所 API 配置
# ==========================================
BITGET_API_KEY=your_bitget_api_key_here
BITGET_API_SECRET=your_bitget_api_secret_here
BITGET_PASSPHRASE=your_bitget_passphrase_here

# ==========================================
# 其他配置
# ==========================================
# 是否启用测试模式（本地模拟，不发送真实请求）
TEST_MODE=false

# 是否使用 Bitget 模拟盘（需要模拟盘 API Key）
# 注意：
#   - demo_trading=true 需要配合 test_mode=false 使用才会真实连接 Bitget 模拟盘
#   - 如果 test_mode=true，则只会在本地模拟，不会连接 Bitget
#   - 模拟盘 API Key 需要在 Bitget 网站创建（个人中心 -> 模拟盘 -> API 管理）
DEMO_TRADING=true

# 日志级别 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ==========================================
# 交易参数配置（用于测试脚本）
# ==========================================
# 默认交易金额 (USDT)
TRADE_AMOUNT=100.0

# 止盈比例（例如 0.05 表示 5%）
TAKE_PROFIT_RATIO=0.05

# 止损比例（例如 0.02 表示 2%）
STOP_LOSS_RATIO=0.02
